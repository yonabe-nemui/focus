<?xml version="1.0" encoding="utf-8"?>
<!--
  Focus — ic_launcher_background.xml
  Android adaptive icon background layer.
  Solid Focus Green (#2E7D5B) with 3 concentric hairline rings.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Background fill — Focus Green -->
    <path
        android:fillColor="#2E7D5B"
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z" />

    <!-- Concentric hairline rings: r=15, r=30, r=45 — white 6/4/3% -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#0FFFFFFF"
        android:strokeWidth="0.6"
        android:pathData="M54,39 A15,15 0 1,1 53.999,39 Z" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#0AFFFFFF"
        android:strokeWidth="0.6"
        android:pathData="M54,24 A30,30 0 1,1 53.999,24 Z" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#07FFFFFF"
        android:strokeWidth="0.6"
        android:pathData="M54,9 A45,45 0 1,1 53.999,9 Z" />
</vector>
