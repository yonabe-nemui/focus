<?xml version="1.0" encoding="utf-8"?>
<!--
  Focus — ic_launcher_foreground.xml
  Android adaptive icon foreground layer.
  White focus-ring glyph on transparent background.
  108×108dp canvas — artwork inside 72×72dp safe zone (centred at 54,54).

  Glyph:
    - Outer ring   r=28, stroke=3.5  "looking at something"
    - Inner dot    r=9, filled        "the point of focus"
    - Four tick marks at N/E/S/W      crosshair feel
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer ring -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.5"
        android:pathData="M54,26 A28,28 0 1,1 53.999,26 Z" />

    <!-- Tick marks — North, South, East, West (6dp long, 1dp gap from ring) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M54,12 L54,18" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M54,90 L54,96" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M90,54 L96,54" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M12,54 L18,54" />

    <!-- Inner filled dot -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,45 A9,9 0 1,1 53.999,45 Z" />

</vector>
